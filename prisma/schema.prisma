// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  password       String     // hashed, never plaintext
  name           String?
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime   @default(now())

  links Link[]

  @@map("users")
}

model Link {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  originalUrl String
  shortCode   String    @unique // base62, e.g. "aZ3kP9"
  customAlias String?   @unique // v2 feature, nullable di v1
  expiryDate  DateTime? // v2 feature, nullable di v1
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())

  clicks Click[]

  @@index([userId])
  @@map("links")
}

model Click {
  id         String   @id @default(cuid())
  linkId     String
  link       Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  clickedAt  DateTime @default(now())
  ipAddress  String   // ALWAYS masked (e.g. "103.21.244.xxx") — raw IP is never persisted
  country    String?
  city       String?
  deviceType String?  // "mobile" | "desktop" | "tablet"
  browser    String?
  referrer   String?

  @@index([linkId, clickedAt])
  @@map("clicks")
}
