# Database (PostgreSQL - Neon, Supabase, or local PostgreSQL)
# DATABASE_URL is used by the app runtime.
# DIRECT_URL (optional) overrides the connection used by Prisma CLI/migrations
# (e.g. a non-pooled direct connection when DATABASE_URL goes through PgBouncer).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shortlytics?schema=public"
DIRECT_URL=""

# NextAuth / Auth.js
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Upstash Redis (Optional for local dev, used for rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# IP Geolocation (Optional, fallback available)
IPINFO_API_TOKEN=""

# Domain Configuration
# NEXT_PUBLIC_APP_DOMAIN is the SINGLE source of truth for the app domain,
# used by BOTH the server (short-URL construction + anti-loop via
# getAppDomain()) and the client (landing page's demo console). Set it to the
# real production domain; the byte value is identical everywhere, so the two
# can never drift apart.
# APP_DOMAIN (legacy, optional) is kept only as a silent fallback for older
# configs — prefer NEXT_PUBLIC_APP_DOMAIN.
NEXT_PUBLIC_APP_DOMAIN="shortlytics.app"
# APP_DOMAIN="shortlytics.app"
